{
  "name": "helpdesk",
  "version": "1.1.0",
  "description": "AI-powered support desk: student emails become tickets, Claude classifies them and drafts replies for agents to review.",
  "author": "Ahmed Ali Mahjoub",
  "license": "MIT",
  "homepage": "https://app.helpdesk.mahjoub.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EngAhmedMahjoub/helpdesk.git"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@helpdesk/api' --filter '@helpdesk/web' dev",
    "build": "bun --filter '@helpdesk/web' build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun --filter '@helpdesk/api' --filter '@helpdesk/web' test",
    "test:e2e": "bun --filter '@helpdesk/e2e' test:e2e",
    "test:e2e:ui": "bun --filter '@helpdesk/e2e' test:e2e:ui"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
