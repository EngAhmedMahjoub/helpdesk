# Loaded automatically by `bun test`, which sets NODE_ENV=test.
# No secrets here: it is the origin the dev server serves the app from.

# The origin the test DOM is registered at. happy-dom's default, about:blank, is
# not a valid base for resolving a relative URL, and axios reads location.origin
# at import to decide whether a request is same-origin — so every call to /api/…
# failed before the request was built. test/setup.ts has no default for this.
WEB_ORIGIN="http://localhost:5173"
