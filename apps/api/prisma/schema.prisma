// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  agent
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(agent)
  isActive        Boolean   @default(true)
  // Set by the seed on the admin it creates. Nobody can deactivate a protected
  // user: with no admin left active, nobody could manage users through the app,
  // and the seed would not bring them back.
  isProtected     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  messages        Message[]
  assignedTickets Ticket[]
  reviewedDrafts  ReplyDraft[]
}

model Session {
  id        String   @id @default(uuid())
  // SHA-256 of the raw token; the raw token only ever lives in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TicketStatus {
  open
  resolved
  closed
}

enum TicketCategory {
  general
  technical
  refund
}

enum EscalationReason {
  refund_approval
  ai_failed
}

model Ticket {
  id               Int               @id @default(autoincrement())
  subject          String
  studentEmail     String
  // Nullable: an email's From header need not carry a display name.
  studentName      String?
  status           TicketStatus      @default(open)
  // Null until the AI or an agent classifies the ticket.
  category         TicketCategory?
  summary          String?
  needsAgent       Boolean           @default(false)
  // Why needsAgent was set; null while it is false.
  escalationReason EscalationReason?
  // Only a Resolved ticket has one: when auto-close will set it Closed.
  autoCloseAt      DateTime?
  // Who is responsible for the ticket; null while nobody is. A label, not a
  // permission: anyone can still reply or change status. SetNull rather than
  // Restrict, unlike Message.agentId, because an assignment is not a record
  // worth keeping a user row for.
  assigneeId       String?
  assignee         User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         Message[]
  replyDrafts      ReplyDraft[]

  // Postgres does not index a foreign key by itself, and this one is read from
  // both ends: the "Assigned to me" filter (task 3.15), and the SET NULL that
  // deleting a user runs across every ticket.
  @@index([assigneeId])
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageAuthor {
  student
  ai
  agent
}

model Message {
  id             Int              @id @default(autoincrement())
  ticketId       Int
  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  author         MessageAuthor
  // The agent who wrote it; null for student and AI messages. Restrict, so a
  // user row cannot be deleted out from under the replies they sent.
  agentId        String?
  agent          User?            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  body           String
  // The email's Message-ID, set on inbound messages. Null on outbound ones:
  // Resend sends through Amazon SES, which sets its own Message-ID and does not
  // report it back. Unique, so the same inbound email delivered twice cannot
  // become two messages.
  emailMessageId String?          @unique
  createdAt      DateTime         @default(now())

  @@index([ticketId])
}

enum DraftStatus {
  pending
  approved
  rejected
}

/// A reply the AI drafted but may not send by itself — a refund, which a
/// person approves (5.13). Approving sends it as an outbound message (6.2);
/// rejecting leaves the ticket with an agent (6.3).
model ReplyDraft {
  id           Int         @id @default(autoincrement())
  ticketId     Int
  // A draft is about its ticket and nothing else, so it goes with it.
  ticket       Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body         String
  status       DraftStatus @default(pending)
  // Who approved or rejected it, and when; both null while it is pending.
  // Restrict, as on Message.agentId: an approval is a record of who let a
  // refund reply go out, and a user row must not be deleted out from under it.
  reviewedById String?
  reviewedBy   User?       @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Postgres indexes neither foreign key by itself. ticketId is read when a
  // ticket's drafts are listed for review (6.1) and by the cascade;
  // reviewedById by the Restrict check that runs whenever a user is deleted.
  @@index([ticketId])
  @@index([reviewedById])
}
