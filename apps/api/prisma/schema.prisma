// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  agent
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(agent)
  isActive     Boolean   @default(true)
  // Set by the seed on the admin it creates. Nobody can deactivate a protected
  // user: with no admin left active, nobody could manage users through the app,
  // and the seed would not bring them back.
  isProtected  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  // SHA-256 of the raw token; the raw token only ever lives in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TicketStatus {
  open
  resolved
  closed
}

enum TicketCategory {
  general
  technical
  refund
}

enum EscalationReason {
  refund_approval
  ai_failed
}

model Ticket {
  id               Int               @id @default(autoincrement())
  subject          String
  studentEmail     String
  // Nullable: an email's From header need not carry a display name.
  studentName      String?
  status           TicketStatus      @default(open)
  // Null until the AI or an agent classifies the ticket.
  category         TicketCategory?
  summary          String?
  needsAgent       Boolean           @default(false)
  // Why needsAgent was set; null while it is false.
  escalationReason EscalationReason?
  // Only a Resolved ticket has one: when auto-close will set it Closed.
  autoCloseAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}
