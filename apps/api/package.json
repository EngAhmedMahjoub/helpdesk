{
  "name": "@helpdesk/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun --env-file=.env run prisma generate",
    "db:migrate": "bun --bun --env-file=.env run prisma migrate dev",
    "db:seed": "bun --bun --env-file=.env run prisma db seed",
    "db:studio": "bun --bun --env-file=.env run prisma studio",
    "lint": "oxlint --deny-warnings",
    "test": "bun test"
  },
  "dependencies": {
    "@helpdesk/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.81.0",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2"
  }
}
