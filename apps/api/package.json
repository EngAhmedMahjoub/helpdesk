{
  "name": "@helpdesk/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun --env-file=.env run prisma generate",
    "db:migrate": "bun --bun --env-file=.env run prisma migrate dev",
    "db:test:setup": "bun --bun --env-file=.env.test run prisma migrate deploy",
    "db:seed": "bun --bun --env-file=.env run prisma db seed",
    "db:seed:dev": "bun --env-file=.env prisma/seed-dev.ts",
    "db:studio": "bun --bun --env-file=.env run prisma studio",
    "lint": "oxlint --deny-warnings",
    "test": "bun run db:test:setup && bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@helpdesk/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pg-boss": "^12.34.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.81.0",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2"
  }
}
