# Required. Gates the Secure flag on the session cookie, so there is deliberately
# no default: a deploy that forgets it must fail to boot, not quietly serve a
# cookie usable over plain HTTP. One of development, test, production.
NODE_ENV=development
# Optional, defaults to 3000
PORT=3000
# Matches the db service in compose.yaml at the repo root
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"
# Required, no default. The single origin allowed to call the API with
# credentials; production uses https://app.helpdesk.mahjoub.io. Defaulting this would let a
# production deploy that forgot it trust a localhost dev server instead.
WEB_ORIGIN="http://localhost:5173"

# Required. A key from Resend's API keys page with Full access: a sending-only
# key is refused (restricted_api_key) when reading a received email's body.
# One key per environment, so either can be revoked alone; production sets its
# own as a Koyeb secret.
RESEND_API_KEY="re_replace-with-your-key"
# Required. The sender on every outbound email; its domain must be verified in
# Resend.
EMAIL_FROM="Helpdesk Support <support@helpdesk.mahjoub.io>"
# Required. The signing secret of the webhook endpoint in Resend (Webhooks, then
# the endpoint). Each endpoint has its own: the local tunnel's and production's
# differ.
RESEND_WEBHOOK_SECRET="whsec_replace-with-your-secret"

# Read only by `bun run db:seed`, never by the running API. Replace both in your
# own .env; production sets its own values as Koyeb secrets.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"

# Anthropic. Your own key from the Claude Console; the API refuses to boot
# without one. Set a monthly spend limit on the key before using it (8.13).
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Required, at least 32 characters. The shared secret the scheduled GitHub
# Actions workflow sends to /api/tasks/*; generate one with `openssl rand -hex 32`.
# Production sets its own as a Koyeb secret, and the same value as a GitHub
# Actions secret.
TASKS_SECRET="replace-with-openssl-rand-hex-32-output"
