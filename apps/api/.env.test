# Loaded automatically by `bun test`, which sets NODE_ENV=test. Overrides .env so
# tests never touch the development database or its seeded admin.
# No secrets here: these are the compose Postgres credentials, same as .env.example.
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk_test?schema=public"

# Required by src/env.ts, which has no default for it. Nothing in the tests makes
# a cross-origin request; this only has to be a valid origin.
WEB_ORIGIN="http://localhost:5173"

# Required by src/env.ts. Not a real key: Resend refuses it, so a test that
# reached the real client by mistake fails instead of sending mail.
RESEND_API_KEY="re_test_not_a_real_key"
EMAIL_FROM="Helpdesk Support <support@helpdesk.example.com>"

# Required by src/env.ts. Random, and used by nothing but the tests, which sign
# their own webhook requests with it.
RESEND_WEBHOOK_SECRET="whsec_o5j/p2U0nprdruuhKUgX81SyGhWUM9Pq"

# Anthropic (5.6). Not a real key in this file; the API only checks the prefix here.
ANTHROPIC_API_KEY=sk-ant-test-not-a-real-key

# Scheduled tasks (5.16). Not a real secret; the task tests send it themselves.
TASKS_SECRET="test-tasks-secret-not-a-real-one-0000"
