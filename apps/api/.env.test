# Loaded automatically by `bun test`, which sets NODE_ENV=test. Overrides .env so
# tests never touch the development database or its seeded admin.
# No secrets here: these are the compose Postgres credentials, same as .env.example.
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk_test?schema=public"

# Required by src/env.ts, which has no default for it. Nothing in the tests makes
# a cross-origin request; this only has to be a valid origin.
WEB_ORIGIN="http://localhost:5173"
